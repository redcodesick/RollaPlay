{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RollaPlay",
  "version": "0.3.1",
  "identifier": "app.windowsmediastation.local",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RollaPlay",
        "width": 1360,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/thumbnails/**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "A private local media library for Windows",
    "longDescription": "Browse local video files and stream them to Google Cast devices on your home network.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/redcodesick/RollaPlay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2OEUxNkUxQzEzRDVCOUYKUldTZld6M0I0UmFPcHBBL25JK3FkWk5reFd5dmxac1k0VlhjZU42R1FyMEVrN2lldjNvKzAyTHAK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
